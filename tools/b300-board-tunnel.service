[Unit]
Description=Cloudflare Quick Tunnel for the B300 board
ConditionHost=della-tridao.princeton.edu
Wants=agent-bus-v2-page.service
After=agent-bus-v2-page.service

[Service]
Type=simple
StateDirectory=b300-board-tunnel
StateDirectoryMode=0700
UMask=0077
ExecStartPre=/usr/bin/rm -f %S/b300-board-tunnel/url %S/b300-board-tunnel/url.new
ExecStart=/usr/bin/python3 -IB %h/.local/bin/b300-board-tunnel %S/b300-board-tunnel
ExecStopPost=/usr/bin/rm -f %S/b300-board-tunnel/url %S/b300-board-tunnel/url.new
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
